    {
      "id": "m16",
      "question": "How do I retry MCP tool calls that fail because of rate limits?",
      "inScope": true,
      "askedAt": "2026-09-29T20:00:39.081Z",
      "classification": "answered-with-citations",
      "answer": "Pass `maxRetries` when creating the MCP client to enable automatic retries for `tools/call` requests; for example, set `maxRetries: 2`. Retries are disabled by default, and built-in matching covers transient HTTP and network failures, including rate limits. [1: \"MCP tool calls can fail for transient transport reasons, such as rate limits\"] Only enable retries for tools where retrying is safe, since repeating non-idempotent calls can duplicate side effects. [1: \"Retrying non-idempotent tools, such as tools that send emails or create records, can duplicate side effects.\"]",
      "citations": [
        {
          "type": "citation",
          "n": 1,
          "quote": "MCP tool calls can fail for transient transport reasons, such as rate limits",
          "status": "verified"
        },
        {
          "type": "citation",
          "n": 1,
          "quote": "Retrying non-idempotent tools, such as tools that send emails or create records, can duplicate side effects.",
          "status": "verified"
        }
      ],
